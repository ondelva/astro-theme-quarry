---
// A plain text page: a heading, an optional lead, then prose. About, Contact and the
// two legal pages share it, which is why none of them carries its own container
// arithmetic. Pages with structure of their own (the home page, pricing) do not use it.
import type { ComponentProps } from 'astro/types';
import Base from './Base.astro';

interface Props extends ComponentProps<typeof Base> {
  heading: string;
  lead?: string;
  updated?: string; // legal pages say when they last changed; others leave it off
}
const { heading, lead, updated, ...seo } = Astro.props;
---

<Base {...seo}>
  <div class="shell">
    <div class="shell-body pt-14 pb-20 sm:pt-20">
      <h1 class="text-3xl font-medium tracking-[-0.028em] sm:text-4xl">{heading}</h1>
      {lead && <p class="text-muted mt-5 text-lg">{lead}</p>}
      {updated && <p class="text-faint mt-6 font-mono text-[11px]">Last updated {updated}</p>}
      <div class="prose border-border mt-10 border-t pt-10">
        <slot />
      </div>
    </div>
  </div>
</Base>
