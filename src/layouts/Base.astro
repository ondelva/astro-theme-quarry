---
import type { ComponentProps } from 'astro/types';
import { Font } from 'astro:assets';
import '../styles/global.css';
import SEO from '../components/common/SEO.astro';
import DemoBar from '../components/common/DemoBar.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import Analytics from '../components/common/Analytics.astro';
import { site } from '../config';

type Props = ComponentProps<typeof SEO>;
const seo = Astro.props;
---

<html lang={Astro.currentLocale ?? site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    {/* The faces from the fonts block in astro.config.mjs. Without these the site
        renders in the system fallbacks. Preload what is above the fold: body 400 and
        the 500 that carries every heading. A face that swaps in late shifts the page. */}
    <Font
      cssVariable="--font-body"
      preload={[
        { weight: '400', style: 'normal' },
        { weight: '500', style: 'normal' },
      ]}
    />
    <Font cssVariable="--font-mono" preload={[{ weight: '400', style: 'normal' }]} />
    <SEO {...seo} />
    <script is:inline>
      // Before first paint, or the page flashes the system theme.
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark')
          document.documentElement.setAttribute('data-theme', saved);
      } catch {}
    </script>
    <Analytics />
  </head>
  <body class="bg-background text-foreground flex min-h-screen flex-col">
    <a
      href="#main"
      class="bg-foreground text-background font-ui sr-only z-50 text-sm no-underline focus:fixed focus:top-4 focus:left-4 focus:not-sr-only focus:px-4 focus:py-2"
    >
      Skip to content
    </a>
    <DemoBar />
    <Header />
    <main id="main" tabindex="-1" class="flex-1 outline-none">
      <slot />
    </main>
    <Footer />
  </body>
</html>
