---
// The one list of posts. The index, the tag pages and anything later that shows a
// run of writing use this; a second card built for one screen is how two lists end
// up disagreeing about what a date looks like.
import type { CollectionEntry } from 'astro:content';
import { formatDate, isoDate, tagSlug } from '../../lib/content';

interface Props {
  posts: CollectionEntry<'blog'>[];
  // Off on a tag page: the tag is already the heading there, and repeating it on
  // every row says the same thing a dozen times.
  showTags?: boolean;
  // The row title's level. The list sits under the page's `h1` by default; pass `h3`
  // where it sits under a heading of its own, so the outline never skips a level.
  as?: 'h2' | 'h3';
}
const { posts, showTags = true, as: Title = 'h2' } = Astro.props;
---

<ol class="border-border max-w-content border-t">
  {posts.map(({ id, data }) => (
    <li class="border-border border-b py-5">
      <p class="text-faint font-mono text-[11px]">
        <time datetime={isoDate(data.pubDate)}>{formatDate(data.pubDate)}</time>
      </p>
      <Title class="mt-1.5 text-base font-medium tracking-[-0.028em]">
        <a
          class="no-underline hover:underline hover:underline-offset-[0.15em]"
          href={`/blog/${id}`}
        >
          {data.title}
        </a>
      </Title>
      <p class="text-muted mt-1.5 text-sm">{data.description}</p>
      {showTags && data.tags.length > 0 && (
        <ul class="text-faint mt-2.5 flex flex-wrap gap-x-4 font-mono text-[11px]">
          {data.tags.map((tag) => (
            <li>
              <a class="hover:text-foreground no-underline" href={`/blog/tag/${tagSlug(tag)}`}>
                {tag}
              </a>
            </li>
          ))}
        </ul>
      )}
    </li>
  ))}
</ol>
