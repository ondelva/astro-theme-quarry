---
// Sticky, one hairline, no dropdown. Four links and a call to action fit on one row
// at 640px and wrap to a second row below it, which is cheaper than a menu that
// needs script to open.
import { features, nav, site } from '../../config';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
// In-page links (/#how) are not a destination, so they never claim the current page.
const isCurrent = (href: string) =>
  !href.includes('#') && (href === path || path.startsWith(`${href}/`));
---

<header class="bg-background border-border sticky top-0 z-40 border-b">
  <div class="shell flex flex-wrap items-center gap-x-6 gap-y-3 py-3">
    <a href="/" class="font-ui text-base font-semibold tracking-[-0.028em] no-underline">
      {site.name}
    </a>

    <nav aria-label="Main" class="order-last w-full sm:order-none sm:w-auto">
      <ul class="flex flex-wrap items-center gap-x-5 gap-y-1 text-sm">
        {nav.header.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              class="text-muted hover:text-foreground aria-[current=page]:text-foreground no-underline"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-4">
      {features.darkMode && <ThemeToggle />}
      <a href={nav.cta.href} class="btn btn--quiet whitespace-nowrap">
        {nav.cta.label}
      </a>
    </div>
  </div>
</header>
