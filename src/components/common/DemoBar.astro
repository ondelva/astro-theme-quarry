---
// Demo-site only: renders nothing unless PUBLIC_DEMO_BUY_URL is set at build time, so a
// buyer's build is unaffected. Set it alongside SITE_URL when building the demo.
const href = import.meta.env.PUBLIC_DEMO_BUY_URL;
---

{href && (
  <aside class="bg-surface border-border border-b">
    <p class="shell text-faint font-mono py-2 text-[11px]">
      Quarry (free) demo ·{' '}
      <a class="text-primary underline" href={href}>
        See what Pro adds &rarr;
      </a>
    </p>
  </aside>
)}
