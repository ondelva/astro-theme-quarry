---
// The signature, as one element. Wrap a run of these in a `.rail` container and the
// numbers count themselves; the styles live in the components layer of global.css so
// that anything else can wear the same label without importing this file.
import { features } from '../../config';

interface Props {
  label: string;
  // A second line in the rail -- a date, a version, a count. `flag` is the same
  // line in the danger colour, for the one that has to be noticed.
  note?: string;
  flag?: string;
  numbered?: boolean; // off where the label already is the ordinal
  id?: string;
  // The label is a `<p>` where the section title is not the page's outline. Where it
  // IS the outline, make it a heading and let the section's own `###` follow it.
  as?: 'p' | 'h2' | 'h3';
  class?: string; // the page sets the space above; sections are not all the same height
}
const { label, note, flag, numbered = true, id, as: Label = 'p', class: className } = Astro.props;
---

<section
  id={id}
  class:list={[
    'rail-section',
    !numbered && 'rail-section--bare',
    !features.marginalIndex && 'rail-section--inline',
    className,
  ]}
>
  <Label class="rail-label">
    <span class="rail-rule"></span>
    {label}
    {note && <span class="rail-note">{note}</span>}
    {flag && <span class="rail-note text-danger">{flag}</span>}
  </Label>
  <div class="rail-body">
    <slot />
  </div>
</section>
