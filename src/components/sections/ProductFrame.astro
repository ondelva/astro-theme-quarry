---
// A drawing of the product, in rules and mono text rather than a screenshot: no asset to
// license, no second file to re-shoot for dark mode, and it stays sharp at any width.
// A buyer swaps the rows below for their own, or replaces the whole file with a picture.
const query = 'ranking AND after:2016';
const hits = [
  {
    path: '~/notes/2017-03-ranking-pass.md',
    line: 41,
    before: 'the ',
    match: 'ranking',
    after: ' pass runs after the filter, never before it',
  },
  {
    path: '~/src/quarry/score.rs',
    line: 188,
    before: 'fn ',
    match: 'ranking',
    after: '_weights() -> Weights { Weights::from_config(cfg) }',
  },
  {
    path: '~/notes/meetings/2019-11-14.md',
    line: 7,
    before: 'agreed to leave ',
    match: 'ranking',
    after: ' alone until the index format settles',
  },
];
---

<figure class="border-border border">
  <div class="border-border text-faint flex flex-wrap items-baseline gap-x-2 border-b px-3 py-2 font-mono text-[11px]">
    <span class="text-foreground">quarry</span>
    <span>search</span>
    <span class="text-primary">"{query}"</span>
  </div>

  <ol class="font-mono text-[11px] leading-relaxed">
    {hits.map((hit) => (
      <li class="border-border border-b px-3 py-2.5 last:border-b-0">
        <p class="text-faint flex justify-between gap-3">
          <span class="truncate">{hit.path}</span>
          <span>:{hit.line}</span>
        </p>
        <p class="mt-1 truncate">
          {hit.before}
          <mark>{hit.match}</mark>
          {hit.after}
        </p>
      </li>
    ))}
  </ol>

  <figcaption class="border-border text-faint border-t px-3 py-2 font-mono text-[11px]">
    3 of 118 matches · 41,802 files indexed · 24 ms
  </figcaption>
</figure>
