---
// Home. Section copy lives here as plain data, not in a collection: a buyer edits one
// file to change the landing page, and nothing else reads these strings.
import Base from '../layouts/Base.astro';
import Section from '../components/common/Section.astro';
import ProductFrame from '../components/sections/ProductFrame.astro';
import { getPlans, money } from '../lib/content';

const hero = {
  eyebrow: 'Local index · macOS and Linux',
  heading: 'Find the sentence you wrote in 2016.',
  lead: 'Point Quarry at the folders you already keep. It builds one index on your machine and answers from it in place, so a search over ten years of notes comes back before you have let go of the return key.',
  actions: [
    { label: 'Download 1.4', href: '/#how', primary: true },
    { label: 'See the plans', href: '/pricing' },
  ],
  footnote: '14 MB · macOS 13 and later · Linux on x86-64 · free to 20,000 files',
};

// Numbered 1, 2, 3 on screen, not 01, 02, 03: the two-digit accent number belongs to the
// rail, and two numbering schemes on one page read as one muddled scheme.
const steps = [
  {
    command: 'quarry init ~/notes ~/src',
    detail:
      'Name the folders. Everything under them is indexed unless a rule file says otherwise, and the rule files use the syntax you already write in .gitignore.',
  },
  {
    command: 'quarry index',
    detail:
      'The first pass over 40,000 files takes about four minutes on a 2021 laptop. After that the daemon watches and re-reads only what changed.',
  },
  {
    command: 'quarry search "release notes"',
    detail: 'Or open the app, or call the endpoint. One index, one order of results.',
  },
];

const capabilities = [
  {
    name: 'Query syntax',
    detail: 'AND, OR, NOT, quoted phrases, and filters on path, extension and date.',
  },
  {
    name: 'Snippets from the file',
    detail: 'The matching line with the two around it, read from disk when you ask, not stored.',
  },
  {
    name: 'Saved searches',
    detail: 'A query you name once. The app keeps a live count beside it as the index changes.',
  },
  {
    name: 'Rule files',
    detail: 'A .quarryignore per folder, checked into the repository if you want it shared.',
  },
  {
    name: 'A loopback endpoint',
    detail: '127.0.0.1:7433, JSON in and out, which is how the editor plugins talk to it.',
  },
  {
    name: 'Exit codes that mean something',
    detail:
      '0 for matches, 1 for none, 2 for a query it could not parse. Scripts can branch on it.',
  },
];

const questions = [
  {
    q: 'Does anything leave my machine?',
    a: 'No. The index is a file under ~/.local/share/quarry. The one outbound request is a version check every seven days, and a line in the settings file turns it off.',
  },
  {
    q: 'What happens when my licence runs out?',
    a: 'The version you have keeps working. You stop receiving updates two years after purchase, and a new key starts the two years again.',
  },
  {
    q: 'Can I index a network drive?',
    a: 'Yes, but the watcher falls back to polling every 60 seconds and the first pass is several times slower. A local mirror is the better arrangement if you have one.',
  },
  {
    q: 'Is there a Windows build?',
    a: 'Not yet. The file watcher is the part that has not been written. It is the most requested item in the issue tracker and it is not scheduled.',
  },
];

const plans = await getPlans();
---

<Base description="Quarry indexes the notes, documents and code you already keep, and searches them from your own machine.">
  <div class="shell">
    <div class="shell-body pt-14 pb-16 sm:pt-20">
      <p class="text-faint font-mono text-[11px]">{hero.eyebrow}</p>
      <h1 class="mt-4 text-4xl font-medium tracking-[-0.028em] sm:text-5xl">{hero.heading}</h1>
      <p class="text-muted mt-5 text-lg">{hero.lead}</p>
      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
        {hero.actions.map((action) =>
          action.primary ? (
            <a class="btn" href={action.href}>
              {action.label}
            </a>
          ) : (
            <a class="text-sm underline underline-offset-[0.15em]" href={action.href}>
              {action.label}
            </a>
          ),
        )}
      </div>
      <p class="text-faint mt-7 font-mono text-[11px]">{hero.footnote}</p>
    </div>

    <div class="rail border-border border-t pt-16">
      <Section label="Overview" id="overview">
        <h2 class="text-2xl font-medium tracking-[-0.028em]">
          One window over everything you keep.
        </h2>
        <p class="text-muted mt-4">
          The app, the command line and the endpoint read the same index. Whichever one is in front
          of you, the same query returns the same rows in the same order.
        </p>
        <div class="mt-7">
          <ProductFrame />
        </div>
      </Section>

      <Section label="How it works" id="how" class="mt-24">
        <h2 class="text-2xl font-medium tracking-[-0.028em]">
          Three commands, then it is running.
        </h2>
        <ol class="border-border mt-7 border-t">
          {steps.map((step, i) => (
            <li class="border-border grid grid-cols-[1.25rem_minmax(0,1fr)] gap-x-3 border-b py-4">
              <span class="text-faint pt-0.5 font-mono text-[11px]">{i + 1}</span>
              <div>
                <code class="font-mono text-sm">{step.command}</code>
                <p class="text-muted mt-2 text-sm">{step.detail}</p>
              </div>
            </li>
          ))}
        </ol>
      </Section>

      <Section label="Features" id="features" class="mt-20">
        <h2 class="text-2xl font-medium tracking-[-0.028em]">
          Six things a pipe into grep leaves you to do yourself.
        </h2>
        <dl class="mt-6 grid gap-x-8 sm:grid-cols-2">
          {capabilities.map((item) => (
            <div class="border-border border-t py-4">
              <dt class="text-sm font-medium">{item.name}</dt>
              <dd class="text-muted mt-1.5 text-sm">{item.detail}</dd>
            </div>
          ))}
        </dl>
      </Section>

      <Section label="Pricing" id="pricing" class="mt-24">
        <h2 class="text-2xl font-medium tracking-[-0.028em]">
          Free while the archive is small. Six dollars a month once it is not.
        </h2>
        <ul class="border-border mt-7 border-t">
          {plans.map(({ data }) => (
            <li class="border-border flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b py-4">
              <div class="min-w-0">
                <p class="text-sm font-medium">
                  {data.name}
                  {data.featured && (
                    <span class="text-primary ml-2 font-mono text-[11px] font-normal">
                      most bought
                    </span>
                  )}
                </p>
                <p class="text-muted mt-1 text-sm">{data.tagline}</p>
              </div>
              <p class="text-sm tabular-nums">{money(data.priceMonthly, data.currency)} a month</p>
            </li>
          ))}
        </ul>
        <p class="mt-5 text-sm">
          <a href="/pricing">See what each plan includes</a>
        </p>
      </Section>

      <Section label="Questions" id="questions" class="mt-16">
        <h2 class="text-2xl font-medium tracking-[-0.028em]">What people ask before they buy.</h2>
        <div class="border-border mt-6 border-t">
          {questions.map((item) => (
            <details class="disclosure border-border border-b">
              <summary class="py-3.5 text-sm font-medium">
                {item.q}
              </summary>
              <p class="text-muted pb-4 text-sm">{item.a}</p>
            </details>
          ))}
        </div>
      </Section>
    </div>

    <div class="shell-body border-border mt-24 border-t pt-10">
      <h2 class="text-xl font-medium tracking-[-0.028em]">
        Try it on the folder you actually work in.
      </h2>
      <p class="text-muted mt-3">
        The free version indexes 20,000 files and needs no account. If your archive is larger than
        that, you will know within the first minute.
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3">
        <a class="btn" href="/#how">
          Download 1.4
        </a>
        <a class="text-sm underline underline-offset-[0.15em]" href="/blog">
          Read how it is built
        </a>
      </div>
    </div>
  </div>
</Base>
