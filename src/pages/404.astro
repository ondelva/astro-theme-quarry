---
import Base from '../layouts/Base.astro';
import { ui } from '../config';

const t = ui.notFound;
---

<Base title={t.title} noindex>
  <div class="shell">
    <div class="shell-body pt-20 pb-24">
      <p class="text-faint font-mono text-[11px]">404</p>
      <h1 class="mt-3 text-3xl font-medium tracking-[-0.028em]">{t.heading}</h1>
      <p class="text-muted mt-5">{t.text}</p>
      <ul class="border-border mt-8 border-t text-sm">
        <li class="border-border border-b py-3">
          <a href="/blog">{t.blog}</a>
        </li>
        <li class="border-border border-b py-3">
          <a href="/pricing">{t.pricing}</a>
        </li>
        <li class="border-border border-b py-3">
          <a href="/">{t.home}</a>
        </li>
      </ul>
    </div>
  </div>
</Base>
