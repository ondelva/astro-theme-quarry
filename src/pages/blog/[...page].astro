---
// The writing index. `[...page]` rather than a separate first page: page one is /blog
// and there is one template, so the two cannot drift apart.
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import PostList from '../../components/common/PostList.astro';
import { blog, ui } from '../../config';

const t = ui.blog;
import { getPosts, getTags, tagSlug } from '../../lib/content';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts();
  return paginate(posts, { pageSize: blog.postsPerPage });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const tags = await getTags();
---

<Base
  title={page.currentPage === 1 ? t.title : t.page(page.currentPage)}
  description={t.description}
>
  <div class="shell">
    <div class="shell-body pt-14 pb-12 sm:pt-20">
      <h1 class="text-3xl font-medium tracking-[-0.028em] sm:text-4xl">{t.title}</h1>
      <p class="text-muted mt-5 text-lg">{t.intro}</p>
      {tags.length > 0 && (
        <ul class="text-faint mt-8 flex flex-wrap gap-x-5 gap-y-1 font-mono text-[11px]">
          {tags.map(({ tag }) => (
            <li>
              <a class="hover:text-foreground no-underline" href={`/blog/tag/${tagSlug(tag)}`}>
                {tag}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>

    <div class="shell-body pb-20">
      <PostList posts={page.data} />

      {page.lastPage > 1 && (
        <nav
          aria-label={ui.pagination}
          class="text-faint mt-8 flex items-baseline justify-between gap-4 font-mono text-[11px]"
        >
          {page.url.prev ? <a href={page.url.prev}>{t.newer}</a> : <span />}
          <span>{t.pageOf(page.currentPage, page.lastPage)}</span>
          {page.url.next ? <a href={page.url.next}>{t.older}</a> : <span />}
        </nav>
      )}
    </div>
  </div>
</Base>
