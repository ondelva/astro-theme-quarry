---
// A plain POST to whatever service src/config.ts names. No script, no validation
// library: the browser already refuses to submit an empty required field and marks
// a malformed address, and the styles for both live in global.css.
import Base from '../layouts/Base.astro';
import { contact, nav, ui } from '../config';

const t = ui.contact;
---

<Base title={t.title} description={t.description}>
  <div class="shell">
    <div class="shell-body pt-14 pb-20 sm:pt-20">
      <h1 class="text-3xl font-medium tracking-[-0.028em] sm:text-4xl">{t.heading}</h1>
      <p class="text-muted mt-5 text-lg">{t.intro}</p>

      <form
        class="border-border mt-10 grid gap-5 border-t pt-10"
        action={contact.formEndpoint}
        method="post"
      >
        <div>
          <label class="text-sm font-medium" for="name">
            {t.name}
          </label>
          <input class="mt-1.5" id="name" name="name" type="text" autocomplete="name" required />
        </div>
        <div>
          <label class="text-sm font-medium" for="email">
            {t.email}
          </label>
          <input
            class="mt-1.5"
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            required
          />
        </div>
        <div>
          <label class="text-sm font-medium" for="message">
            {t.message}
          </label>
          <textarea class="mt-1.5" id="message" name="message" rows="6" required></textarea>
          <p class="text-faint mt-2 text-sm" set:html={t.messageHint} />
        </div>
        <div>
          <button class="btn" type="submit">
            {t.send}
          </button>
        </div>
      </form>

      <dl class="border-border mt-12 border-t text-sm">
        <div class="border-border flex flex-wrap gap-x-6 gap-y-1 border-b py-4">
          <dt class="text-faint w-32 font-mono text-[11px]">{t.reply}</dt>
          <dd class="text-muted flex-1">{contact.responseTime}</dd>
        </div>
        <div class="border-border flex flex-wrap gap-x-6 gap-y-1 border-b py-4">
          <dt class="text-faint w-32 font-mono text-[11px]">{t.byMail}</dt>
          <dd class="text-muted flex-1">
            <a href={`mailto:${contact.email}`}>{contact.email}</a>
          </dd>
        </div>
        <div class="border-border flex flex-wrap gap-x-6 gap-y-1 border-b py-4">
          <dt class="text-faint w-32 font-mono text-[11px]">{t.bugs}</dt>
          <dd
            class="text-muted flex-1"
            set:html={t.bugsText.replace('{issues}', nav.social[0].href)}
          />
        </div>
      </dl>
    </div>
  </div>
</Base>
