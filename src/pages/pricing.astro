---
// Pricing. The plans are the `plans` collection; the questions below them are page
// copy, because they are about billing, not about any one plan.
import Base from '../layouts/Base.astro';
import Section from '../components/common/Section.astro';
import { getPlans, money } from '../lib/content';

const plans = await getPlans();

const questions = [
  {
    q: 'What happens at the end of the two years?',
    a: 'The version you have keeps working, with no reduced mode and no nag. You stop receiving new versions. A renewal costs half the original price and starts another two years from the day it is bought.',
  },
  {
    q: 'Can I move a licence to another machine?',
    a: 'There is nothing to move. The key is checked offline against a signature, so the same key works on every machine you sit at. It is one person, not one computer.',
  },
  {
    q: 'What counts as a person on the Team plan?',
    a: 'Anyone who runs Quarry. Seats are named rather than concurrent, and you can change who holds one at any time by writing to us.',
  },
  {
    q: 'Do you invoice?',
    a: 'Yes, for Team purchases and for any purchase over five seats. Purchase orders and a VAT number on the invoice are both fine. Write before you buy and we will send the invoice first.',
  },
  {
    q: 'What is the refund policy?',
    a: 'Thirty days, no reason needed. The free version exists so that you can answer the only question a refund usually settles, which is whether it is fast enough on your archive.',
  },
];
---

<Base
  title="Pricing"
  description="Quarry is free up to 20,000 files. Pro is six dollars a month and includes two years of updates."
>
  <div class="shell">
    <div class="shell-body pt-14 pb-16 sm:pt-20">
      <h1 class="text-3xl font-medium tracking-[-0.028em] sm:text-4xl">
        One price, and a free version that is not a demo.
      </h1>
      <p class="text-muted mt-5 text-lg">
        The free build indexes 20,000 files and never expires. Pro lifts the ceiling and turns on
        the parts that other programs talk to. Prices are in US dollars and exclude any tax your
        country adds.
      </p>
    </div>

    <div class="rail border-border border-t pt-16">
      <Section label="Plans" id="plans">
        <h2 class="sr-only">Plans</h2>
        {plans.map(({ data }) => (
          <article class="border-border border-b py-9 first:pt-0">
            <div class="flex flex-wrap items-baseline gap-x-4 gap-y-2">
              <h3 class="text-xl font-medium tracking-[-0.028em]">{data.name}</h3>
              {data.featured && <p class="text-primary font-mono text-[11px]">Most bought</p>}
              {/* $0 rather than the word: the plan is already called Free, and the
                    three prices only line up when all three are numbers. */}
              <p class="ml-auto text-3xl font-medium tracking-[-0.03em] tabular-nums">
                {money(data.priceMonthly, data.currency)}
                <span class="text-faint text-sm font-normal tracking-normal"> a month</span>
              </p>
            </div>
            <p class="text-muted mt-2">{data.tagline}</p>
            {data.priceMonthly > 0 && (
              <p class="text-faint mt-1 font-mono text-[11px]">
                {money(data.priceMonthly * 12, data.currency)} over twelve months
              </p>
            )}
            <ul class="mt-6 grid gap-2 text-sm">
              {data.features.map((feature) => (
                <li class="text-muted grid grid-cols-[1.25rem_minmax(0,1fr)]">
                  <span class="text-faint" aria-hidden="true">
                    —
                  </span>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
            <p class="mt-7">
              <a class:list={['btn', !data.featured && 'btn--quiet']} href={data.cta.href}>
                {data.cta.label}
              </a>
            </p>
          </article>
        ))}
      </Section>

      <Section label="Billing" id="billing" class="mt-20">
        <h2 class="text-2xl font-medium tracking-[-0.028em]">
          The questions that arrive with a purchase order.
        </h2>
        <div class="border-border mt-6 border-t">
          {questions.map((item) => (
            <details class="border-border border-b">
              <summary class="marker:text-faint cursor-pointer py-3.5 text-sm font-medium">
                {item.q}
              </summary>
              <p class="text-muted pb-4 text-sm">{item.a}</p>
            </details>
          ))}
        </div>
      </Section>
    </div>

    <div class="shell-body border-border mt-24 border-t pt-10">
      <h2 class="text-xl font-medium tracking-[-0.028em]">Start on the free build.</h2>
      <p class="text-muted mt-3">
        It is the same program with a ceiling. If your archive is under 20,000 files you may never
        need to come back to this page.
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3">
        <a class="btn" href="/#how">
          Download 1.4
        </a>
        <a class="text-sm underline underline-offset-[0.15em]" href="/blog">
          Read how it is built
        </a>
      </div>
    </div>
  </div>
</Base>
