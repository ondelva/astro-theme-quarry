---
// Dev-only route (injected in astro.config.mjs). Never built for production.
// This is the page to look at in light, dark, and 360px when tokens change.
import Base from '../layouts/Base.astro';
import ThemeToggle from '../components/common/ThemeToggle.astro';
import Section from '../components/common/Section.astro';

const colors = [
  '--background',
  '--surface',
  '--foreground',
  '--muted',
  '--faint',
  '--border',
  '--primary',
  '--primary-hover',
  '--on-primary',
  '--danger',
];
const sizes = ['text-xs', 'text-sm', 'text-base', 'text-lg', 'text-xl', 'text-2xl', 'text-3xl'];
---

<Base title="Styleguide" noindex>
  <div class="mx-auto max-w-wide space-y-12 px-4 py-12">
    <header class="flex items-baseline justify-between gap-4">
      <h1 class="text-2xl font-bold">Styleguide</h1>
      <ThemeToggle />
    </header>

    <section>
      <h2 class="font-ui text-lg font-semibold">Color</h2>
      <ul class="mt-4 grid grid-cols-[repeat(auto-fill,minmax(10rem,1fr))] gap-3">
        {colors.map((name) => (
          <li class="border-border border p-3">
            <span
              class="block h-10 w-full border border-border"
              style={`background: var(${name})`}
            />
            <code class="font-mono text-xs">{name}</code>
          </li>
        ))}
      </ul>
      <p class="text-muted mt-3 text-sm">
        Contrast is checked by <code class="font-mono">pnpm check:contrast</code>, not by eye.
      </p>
    </section>

    <section>
      <h2 class="font-ui text-lg font-semibold">Type scale</h2>
      <dl class="mt-4 space-y-2">
        {sizes.map((size) => (
          <div class="flex items-baseline gap-4">
            <dt class="font-mono text-muted w-24 shrink-0 text-xs">{size}</dt>
            <dd class={size}>The quick brown fox jumps over the lazy dog</dd>
          </div>
        ))}
      </dl>
    </section>

    <section>
      <h2 class="font-ui text-lg font-semibold">Signature — marginal index</h2>
      <p class="text-muted mt-3 max-w-content text-sm">
        Numbered labels stay in the left margin while their section scrolls past, counting the
        sections of the page. The number is a CSS counter, so it is never typed. Pure CSS, no
        script. <code class="font-mono">features.marginalIndex</code> turns it off.
      </p>

      {/* The real component, not a copy: what the styleguide shows is what pages get. */}
      <div class="rail mt-6">
        {[
          { label: 'Overview', head: 'One window over everything you keep.' },
          { label: 'Pricing', head: 'One licence, bought once.' },
        ].map((item, i) => (
          <Section label={item.label} class={i > 0 ? 'mt-10' : undefined}>
            <h3 class="text-xl font-medium">{item.head}</h3>
            <p class="text-muted mt-3 text-sm">
              The rail holds the reader's place; the body keeps the single measure that every page
              on the site is set to.
            </p>
          </Section>
        ))}
      </div>
    </section>

    <section>
      <h2 class="font-ui text-lg font-semibold">Form controls</h2>
      <p class="text-muted mt-3 max-w-content text-sm">
        Native elements styled in <code class="font-mono">global.css</code>, so a form needs markup
        and nothing else. Errors show after a field is left, never while typing — leave the email
        below empty and tab out of it to see the state.
      </p>

      <form class="mt-6 grid max-w-content gap-5" novalidate>
        <div class="grid gap-1.5">
          <label class="text-sm font-medium" for="sg-name">
            Name
          </label>
          <input
            id="sg-name"
            name="name"
            type="text"
            autocomplete="name"
            placeholder="Ada Example"
          />
        </div>

        <div class="grid gap-1.5">
          <label class="text-sm font-medium" for="sg-email">
            Work email
          </label>
          <input
            id="sg-email"
            name="email"
            type="email"
            autocomplete="email"
            required
            aria-describedby="sg-email-hint"
          />
          <p class="text-faint text-xs" id="sg-email-hint">
            Required. The border turns <span class="text-danger">--danger</span> once the field has
            been left empty or invalid.
          </p>
        </div>

        <div class="grid gap-1.5">
          <label class="text-sm font-medium" for="sg-plan">
            Plan
          </label>
          <select id="sg-plan" name="plan">
            <option>Starter</option>
            <option>Team</option>
            <option>Enterprise</option>
          </select>
        </div>

        <div class="grid gap-1.5">
          <label class="text-sm font-medium" for="sg-message">
            Message
          </label>
          <textarea id="sg-message" name="message" placeholder="Grows as you type."></textarea>
        </div>

        <fieldset class="border-0 p-0">
          <legend class="text-sm font-medium">Contact preference</legend>
          <div class="mt-2 flex flex-wrap gap-x-6 gap-y-2 text-sm">
            <label class="flex items-center gap-2">
              <input type="radio" name="pref" value="email" checked /> Email
            </label>
            <label class="flex items-center gap-2">
              <input type="radio" name="pref" value="none" /> No follow-up
            </label>
            <label class="flex items-center gap-2">
              <input type="checkbox" name="news" /> Send release notes
            </label>
          </div>
        </fieldset>

        <div class="grid gap-1.5">
          <label class="text-muted text-sm font-medium" for="sg-locked">
            Locked field
          </label>
          <input id="sg-locked" type="text" value="team@example.com" disabled />
        </div>

        <div class="flex flex-wrap items-center gap-4">
          <button class="btn btn--quiet" type="submit">
            Send
          </button>
          <a
            class="border-border hover:border-primary border-b pb-0.5 text-sm no-underline"
            href="#"
          >
            Or book a call
          </a>
        </div>
      </form>
    </section>

    <section>
      <h2 class="font-ui text-lg font-semibold">Quote</h2>
      <p class="text-muted mt-3 max-w-content text-sm">
        One treatment for testimonials and pulled sentences: a hairline in the margin, attribution
        in mono. No quotation glyphs, no card.
      </p>
      <blockquote class="max-w-content mt-6 text-lg">
        <p>
          We replaced four pages of onboarding with one, and the support queue went quiet. The
          documentation carried the weight we thought the product had to.
        </p>
        <cite>Devi Rao · Head of Platform, Northsound</cite>
      </blockquote>
    </section>

    <section>
      <h2 class="font-ui text-lg font-semibold">Body copy</h2>
      <div class="max-w-content mt-4">
        <p>
          Body text runs at the measure set by <code class="font-mono">--content-width</code>. It
          carries <a href="#">an inline link</a>, <em>emphasis</em>,{' '}
          <strong>strong emphasis</strong>, and <code class="font-mono">inline code</code>.
        </p>
      </div>
    </section>
  </div>
</Base>
